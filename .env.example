NODE_ENV=production
PORT=4100
# Origin that serves the dashboard, pixel and links. Tracked links in sent mail embed it: don't change it later.
PUBLIC_URL=https://track.shotline.in
# Same Atlas cluster as shotline is fine; the app always uses the "mailtrack" database.
MONGODB_URI=mongodb+srv://...
# Google Cloud OAuth client (Web application). Redirect URI: $PUBLIC_URL/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The only Google account allowed to sign in and send.
ALLOWED_EMAIL=
# openssl rand -hex 32
SESSION_SECRET=
# openssl rand -base64 32   (encrypts the stored Google refresh token; losing it means signing in again)
TOKEN_ENC_KEY=
SELF_OPEN_GRACE_SEC=0
NOTIFY_ON_CLICK=true
NOTIFY_ON_OPEN=false
